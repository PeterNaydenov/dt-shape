{
  "name": "dt-shape",
  "description": "Build data by using shapes",
  "version": "4.0.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/dt-shape.umd.js",
  "types": "./types/main.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./dist/dt-shape.esm.mjs"
      },
      "require": {
        "types": "./types/main.d.cts",
        "default": "./dist/dt-shape.cjs"
      },
      "default": {
        "types": "./types/main.d.cts",
        "default": "./dist/dt-shape.umd.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./skills/*": "./skills/*"
  },
  "files": [
    "dist",
    "types/main.d.ts",
    "types/main.d.cts",
    "src",
    "skills",
    "package.json",
    "README.md",
    "Changelog.md",
    "Migration.guide.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha",
    "cover": "c8 npm test",
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc && node scripts/build-cts-types.js",
    "test:types": "npm run build:types && tsc -p test/types/tsconfig.json"
  },
  "keywords": [
    "dt",
    "structure",
    "data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/dt-shape.git"
  },
  "dependencies": {
    "dt-toolbox": "8.1.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "c8": "^12.0.0",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "rollup": "^4.64.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5",
    "glob": ">=13.0.6"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
